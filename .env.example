################################################################################
# NEBULA / ATLAS ROOT ENVIRONMENT CONFIGURATION TEMPLATE
################################################################################

NODE_ENV=development
PORT=3000

APP_NAME=Nebula
APP_URL=http://localhost:5173
API_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

# JWT SECRETS (Production requires >=32 char distinct secrets)
JWT_ACCESS_SECRET=atlas-development-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=atlas-development-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# OAUTH (Optional for local development)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# EMAIL
EMAIL_PROVIDER=development
EMAIL_FROM=no-reply@nebula-intelligence.com
SMTP_HOST=localhost
SMTP_PORT=1025
