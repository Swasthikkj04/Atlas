// Prisma Schema for Atlas System

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

///////////////////////////////////////////////////////////
// ENUMS
///////////////////////////////////////////////////////////

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum GuestSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CONVERTED
}

enum TriggerType {
  MANUAL
  SCHEDULED
  EVENT
}

enum FindingModule {
  HTML
  DNS
  SSL
  HTTP
  TECHNOLOGY
  PERFORMANCE
}

enum FindingCategory {
  CERTIFICATE
  TLS
  SECURITY_HEADER
  REDIRECT
  DNS_RECORD
  TECHNOLOGY
  PERFORMANCE
  RESPONSE
  GENERAL
  CDN
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChangeSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChangeType {
  ADDED
  REMOVED
  MODIFIED
}

enum EvidenceCategory {
  HTTP_RESPONSE
  HTTP_HEADERS
  HTTP_BODY
  REDIRECT_CHAIN
  DNS_RESPONSE
  TLS_CERTIFICATE
  TECHNOLOGY_SIGNATURE
  COLLECTOR_METADATA
}

///////////////////////////////////////////////////////////
// USER
///////////////////////////////////////////////////////////

model User {
  id           String @id @default(uuid())
  email        String @unique
  fullName     String
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains Domain[]

  @@map("users")
}

///////////////////////////////////////////////////////////
// DOMAIN
///////////////////////////////////////////////////////////

model Domain {
  id                String  @id @default(uuid())
  userId            String
  domainName        String
  monitoringEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  understandingJobs       UnderstandingJob[]
  infrastructureSnapshots InfrastructureSnapshot[]
  changeHistory           ChangeHistory[]
  verifications           InfrastructureVerification[]
  rawEvidences            RawEvidence[]

  @@unique([userId, domainName])
  @@index([userId])
  @@index([domainName])
  @@map("domains")
}

///////////////////////////////////////////////////////////
// UNDERSTANDING JOB
///////////////////////////////////////////////////////////

model UnderstandingJob {
  id       String @id @default(uuid())
  domainId String

  status  JobStatus   @default(PENDING)
  trigger TriggerType

  durationMs Int?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  errorMessage String?

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  infrastructureSnapshot InfrastructureSnapshot?
  verifications          InfrastructureVerification[]

  @@index([domainId])
  @@index([status])
  @@index([startedAt])
  @@map("understanding_jobs")
}

///////////////////////////////////////////////////////////
// SNAPSHOT
///////////////////////////////////////////////////////////

model InfrastructureSnapshot {
  id String @id @default(uuid())

  domainId String
  jobId    String @unique

  responseTimeMs Int
  httpStatus     Int

  payload Json

  createdAt DateTime @default(now())

  domain Domain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  job    UnderstandingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  findings InfrastructureFinding[]
  brief    InfrastructureBrief?

  previousChanges ChangeHistory[]              @relation("PreviousSnapshot")
  currentChanges  ChangeHistory[]              @relation("CurrentSnapshot")
  verifications   InfrastructureVerification[]
  rawEvidences    RawEvidence[]

  @@index([domainId])
  @@index([createdAt])
  @@map("infrastructure_snapshots")
}

///////////////////////////////////////////////////////////
// INFRASTRUCTURE VERIFICATION
///////////////////////////////////////////////////////////

model InfrastructureVerification {
  id String @id @default(uuid())

  domainId   String
  jobId      String
  snapshotId String

  changeDetected  Boolean
  snapshotCreated Boolean

  startedAt   DateTime
  completedAt DateTime
  durationMs  Int

  createdAt DateTime @default(now())

  domain   Domain                 @relation(fields: [domainId], references: [id], onDelete: Cascade)
  job      UnderstandingJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  snapshot InfrastructureSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([domainId, createdAt])
  @@index([jobId])
  @@index([snapshotId])
  @@map("infrastructure_verifications")
}

///////////////////////////////////////////////////////////
// FINDINGS
///////////////////////////////////////////////////////////

model InfrastructureFinding {
  id String @id @default(uuid())

  snapshotId String

  ruleId String

  module   FindingModule     @default(HTTP)
  category FindingCategory
  severity Severity

  title       String
  description String

  createdAt DateTime @default(now())

  snapshot InfrastructureSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([severity])
  @@index([module])
  @@map("infrastructure_findings")
}

///////////////////////////////////////////////////////////
// CHANGE HISTORY
///////////////////////////////////////////////////////////

model ChangeHistory {
  id String @id @default(uuid())

  domainId String

  previousSnapshotId String
  currentSnapshotId  String

  module   FindingModule
  category FindingCategory

  changeType ChangeType
  severity   ChangeSeverity

  title       String
  description String

  detectedAt DateTime @default(now())

  domain           Domain                 @relation(fields: [domainId], references: [id], onDelete: Cascade)
  previousSnapshot InfrastructureSnapshot @relation("PreviousSnapshot", fields: [previousSnapshotId], references: [id], onDelete: Cascade)
  currentSnapshot  InfrastructureSnapshot @relation("CurrentSnapshot", fields: [currentSnapshotId], references: [id], onDelete: Cascade)

  @@index([domainId, detectedAt])
  @@index([severity])
  @@map("change_history")
}

///////////////////////////////////////////////////////////
// AI GENERATED SUMMARY
///////////////////////////////////////////////////////////

model InfrastructureBrief {
  id String @id @default(uuid())

  snapshotId String @unique

  overallHealth String

  summary String

  highlights Json

  recommendations Json

  version Int @default(1)

  createdAt DateTime @default(now())

  snapshot InfrastructureSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("infrastructure_briefs")
}

///////////////////////////////////////////////////////////
// EVIDENCE ARCHITECTURE (ADR-005)
///////////////////////////////////////////////////////////

model RawEvidence {
  id                  String           @id @default(uuid())
  domainId            String
  snapshotId          String?
  collectorName       String
  collectorVersion    String
  category            EvidenceCategory @default(HTTP_RESPONSE)
  payloadType         String
  target              String
  capturedAt          DateTime         @default(now())
  payload             String
  sizeBytes           Int
  compressedSizeBytes Int?
  compressionType     String?          @default("NONE")
  compressionVersion  String?          @default("1.0")
  hashSha256          String
  schemaVersion       Int              @default(1)

  // Provenance fields
  requestMethod     String?
  responseStatus    Int?
  redirectIndex     Int?
  sourceEndpoint    String?
  targetEndpoint    String?
  protocolVersion   String?
  transportProtocol String?

  domain   Domain                  @relation(fields: [domainId], references: [id], onDelete: Cascade)
  snapshot InfrastructureSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([domainId, capturedAt])
  @@index([snapshotId])
  @@index([collectorName])
  @@index([category])
  @@map("raw_evidence")
}

///////////////////////////////////////////////////////////
// GUEST EXPERIENCE SESSION (GP-001)
///////////////////////////////////////////////////////////

model GuestSession {
  id                 String             @id @default(uuid())
  sessionToken       String             @unique
  status             GuestSessionStatus @default(ACTIVE)
  understandingJobId String?
  expiresAt          DateTime
  lastSeenAt         DateTime           @updatedAt
  createdAt          DateTime           @default(now())

  @@index([sessionToken])
  @@index([expiresAt])
  @@map("guest_sessions")
}

