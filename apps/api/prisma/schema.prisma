// Prisma Schema for Atlas System

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

///////////////////////////////////////////////////////////
// ENUMS
///////////////////////////////////////////////////////////

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum UserAccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DEACTIVATED
  DELETED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum MotionPreference {
  SYSTEM
  STANDARD
  REDUCED
}

enum GuestSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CONVERTED
}

enum TriggerType {
  INITIAL
  MANUAL
  SCHEDULED
  EVENT
}

enum DomainUnderstandingStatus {
  IDLE
  QUEUED
  UNDERSTANDING
  FAILED
  STALE
}

enum FindingModule {
  HTML
  DNS
  SSL
  HTTP
  TECHNOLOGY
  PERFORMANCE
}

enum FindingCategory {
  CERTIFICATE
  TLS
  SECURITY_HEADER
  REDIRECT
  DNS_RECORD
  TECHNOLOGY
  PERFORMANCE
  RESPONSE
  GENERAL
  CDN
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChangeSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChangeType {
  ADDED
  REMOVED
  MODIFIED
}

enum EvidenceCategory {
  HTTP_RESPONSE
  HTTP_HEADERS
  HTTP_BODY
  REDIRECT_CHAIN
  DNS_RESPONSE
  TLS_CERTIFICATE
  TECHNOLOGY_SIGNATURE
  COLLECTOR_METADATA
}

///////////////////////////////////////////////////////////
// USER
///////////////////////////////////////////////////////////

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  fullName           String
  passwordHash       String?
  avatarUrl          String?
  lastLoginAt        DateTime?
  status             UserAccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?
  tokenInvalidatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains             Domain[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  reactivationTokens  AccountReactivationToken[]
  sessions            UserSession[]
  oauthAccounts       OAuthAccount[]
  preferences         UserPreference?

  @@map("users")
}

///////////////////////////////////////////////////////////
// DOMAIN
///////////////////////////////////////////////////////////

model Domain {
  id                String  @id @default(uuid())
  userId            String
  domainName        String
  monitoringEnabled Boolean @default(false)

  // INTEL-002: Domain Understanding Schedule & State
  lastUnderstoodAt     DateTime?
  nextUnderstandingAt DateTime?
  understandingStatus  DomainUnderstandingStatus @default(IDLE)
  understandingCadence Int                       @default(86400)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  understandingJobs       UnderstandingJob[]
  infrastructureSnapshots InfrastructureSnapshot[]
  changeHistory           ChangeHistory[]
  verifications           InfrastructureVerification[]
  rawEvidences            RawEvidence[]

  @@unique([userId, domainName])
  @@index([userId])
  @@index([domainName])
  @@index([monitoringEnabled, nextUnderstandingAt])
  @@map("domains")
}

///////////////////////////////////////////////////////////
// UNDERSTANDING JOB
///////////////////////////////////////////////////////////

model UnderstandingJob {
  id       String @id @default(uuid())
  domainId String

  status  JobStatus   @default(PENDING)
  trigger TriggerType

  durationMs Int?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // REFINEMENT-004: Distributed Lease, Heartbeat & Worker Recovery
  leaseUntil   DateTime?
  heartbeatAt  DateTime?
  attemptCount Int       @default(0)
  maxAttempts  Int       @default(3)
  workerId     String?
  nextRetryAt  DateTime?

  errorMessage String?

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  infrastructureSnapshot InfrastructureSnapshot?
  verifications          InfrastructureVerification[]

  @@index([domainId])
  @@index([status])
  @@index([startedAt])
  @@index([status, leaseUntil])
  @@index([status, nextRetryAt])
  @@map("understanding_jobs")
}

///////////////////////////////////////////////////////////
// SNAPSHOT
///////////////////////////////////////////////////////////

model InfrastructureSnapshot {
  id String @id @default(uuid())

  domainId String
  jobId    String @unique

  responseTimeMs Int
  httpStatus     Int

  payload Json

  createdAt DateTime @default(now())

  domain Domain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  job    UnderstandingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  findings InfrastructureFinding[]
  brief    InfrastructureBrief?

  previousChanges ChangeHistory[]              @relation("PreviousSnapshot")
  currentChanges  ChangeHistory[]              @relation("CurrentSnapshot")
  verifications   InfrastructureVerification[]
  rawEvidences    RawEvidence[]

  @@index([domainId])
  @@index([createdAt])
  @@map("infrastructure_snapshots")
}

///////////////////////////////////////////////////////////
// INFRASTRUCTURE VERIFICATION
///////////////////////////////////////////////////////////

model InfrastructureVerification {
  id String @id @default(uuid())

  domainId   String
  jobId      String
  snapshotId String

  changeDetected  Boolean
  snapshotCreated Boolean

  startedAt   DateTime
  completedAt DateTime
  durationMs  Int

  createdAt DateTime @default(now())

  domain   Domain                 @relation(fields: [domainId], references: [id], onDelete: Cascade)
  job      UnderstandingJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  snapshot InfrastructureSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([domainId, createdAt])
  @@index([jobId])
  @@index([snapshotId])
  @@map("infrastructure_verifications")
}

///////////////////////////////////////////////////////////
// FINDINGS
///////////////////////////////////////////////////////////

model InfrastructureFinding {
  id String @id @default(uuid())

  snapshotId String

  ruleId String

  module   FindingModule     @default(HTTP)
  category FindingCategory
  severity Severity

  title       String
  description String

  createdAt DateTime @default(now())

  snapshot InfrastructureSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([severity])
  @@index([module])
  @@map("infrastructure_findings")
}

///////////////////////////////////////////////////////////
// CHANGE HISTORY
///////////////////////////////////////////////////////////

model ChangeHistory {
  id String @id @default(uuid())

  domainId String

  previousSnapshotId String
  currentSnapshotId  String

  module   FindingModule
  category FindingCategory

  changeType ChangeType
  severity   ChangeSeverity

  title       String
  description String

  detectedAt DateTime @default(now())

  domain           Domain                 @relation(fields: [domainId], references: [id], onDelete: Cascade)
  previousSnapshot InfrastructureSnapshot @relation("PreviousSnapshot", fields: [previousSnapshotId], references: [id], onDelete: Cascade)
  currentSnapshot  InfrastructureSnapshot @relation("CurrentSnapshot", fields: [currentSnapshotId], references: [id], onDelete: Cascade)

  @@index([domainId, detectedAt])
  @@index([severity])
  @@map("change_history")
}

///////////////////////////////////////////////////////////
// AI GENERATED SUMMARY
///////////////////////////////////////////////////////////

model InfrastructureBrief {
  id String @id @default(uuid())

  snapshotId String @unique

  overallHealth String

  summary String

  highlights Json

  recommendations Json

  version Int @default(1)

  createdAt DateTime @default(now())

  snapshot InfrastructureSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("infrastructure_briefs")
}

///////////////////////////////////////////////////////////
// EVIDENCE ARCHITECTURE (ADR-005)
///////////////////////////////////////////////////////////

model RawEvidence {
  id                  String           @id @default(uuid())
  domainId            String
  snapshotId          String?
  collectorName       String
  collectorVersion    String
  category            EvidenceCategory @default(HTTP_RESPONSE)
  payloadType         String
  target              String
  capturedAt          DateTime         @default(now())
  payload             String
  sizeBytes           Int
  compressedSizeBytes Int?
  compressionType     String?          @default("NONE")
  compressionVersion  String?          @default("1.0")
  hashSha256          String
  schemaVersion       Int              @default(1)

  // Provenance fields
  requestMethod     String?
  responseStatus    Int?
  redirectIndex     Int?
  sourceEndpoint    String?
  targetEndpoint    String?
  protocolVersion   String?
  transportProtocol String?

  domain   Domain                  @relation(fields: [domainId], references: [id], onDelete: Cascade)
  snapshot InfrastructureSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([domainId, capturedAt])
  @@index([snapshotId])
  @@index([collectorName])
  @@index([category])
  @@map("raw_evidence")
}

///////////////////////////////////////////////////////////
// GUEST EXPERIENCE SESSION (GP-001)
///////////////////////////////////////////////////////////

model GuestSession {
  id                 String             @id @default(uuid())
  sessionToken       String             @unique
  domain             String?
  status             GuestSessionStatus @default(ACTIVE)
  understandingJobId String?
  expiresAt          DateTime
  lastSeenAt         DateTime           @updatedAt
  createdAt          DateTime           @default(now())

  @@index([sessionToken])
  @@index([expiresAt])
  @@map("guest_sessions")
}

///////////////////////////////////////////////////////////
// EMAIL VERIFICATION TOKEN (AUTH-001)
///////////////////////////////////////////////////////////

model VerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("verification_tokens")
}

///////////////////////////////////////////////////////////
// PASSWORD RESET TOKEN (AUTH-002)
///////////////////////////////////////////////////////////

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

///////////////////////////////////////////////////////////
// STATEFUL USER SESSION PLATFORM (AUTH-003)
///////////////////////////////////////////////////////////

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  deviceName       String?
  deviceType       String?
  browser          String?
  operatingSystem  String?
  ipAddress        String?
  userAgent        String?
  lastActivityAt   DateTime
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("user_sessions")
}

///////////////////////////////////////////////////////////
// OAUTH PROVIDER ACCOUNT (AUTH-004)
///////////////////////////////////////////////////////////

model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  providerEmail  String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

///////////////////////////////////////////////////////////
// USER PREFERENCES & APPEARANCE (AX-107)
///////////////////////////////////////////////////////////

model UserPreference {
  id        String           @id @default(uuid())
  userId    String           @unique
  theme     ThemePreference  @default(SYSTEM)
  motion    MotionPreference @default(SYSTEM)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

///////////////////////////////////////////////////////////
// ACCOUNT REACTIVATION TOKEN (AX-112)
///////////////////////////////////////////////////////////

model AccountReactivationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("account_reactivation_tokens")
}






