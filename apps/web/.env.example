################################################################################
# NEBULA / ARGONION FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
################################################################################

# API BASE URL
# In local development: leave empty to use Vite reverse proxy (/api -> http://localhost:3000)
# In production build: leave empty for same-origin or specify 'https://api.argonion.com'
VITE_API_URL=

# APPLICATION URL
# Development: http://localhost:5173
# Production GX: https://app.argonion.com
# Production WX: https://nebula.argonion.com
VITE_APP_URL=http://localhost:5173
